# Copy to .env and replace the placeholder with: openssl rand -hex 32
# Never commit .env or share your secret.
WEBUI_SECRET_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL

# Default: local-only browser access at http://localhost:3000
WEBUI_BIND_ADDRESS=127.0.0.1
WEBUI_PORT=3000
WEBUI_NAME=Fitoway AI Platform

# Disable public registration after the initial administrator is created.
ENABLE_SIGNUP=true

# For production, pin a specific release instead of a rolling tag.
OPEN_WEBUI_TAG=main
OLLAMA_TAG=latest
